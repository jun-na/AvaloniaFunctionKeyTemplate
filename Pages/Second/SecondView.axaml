<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaFunctionKeyTemplate.Pages.Second"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="AvaloniaFunctionKeyTemplate.Pages.Second.SecondView"
             x:DataType="vm:SecondViewModel">

    <Design.DataContext>
        <vm:SecondViewModel />
    </Design.DataContext>

    <Grid Margin="12" RowDefinitions="Auto,*">
        <Border Classes="xp-header">
            <TextBlock Classes="xp-title" Text="SecondView" />
        </Border>

        <Border Grid.Row="1"
                Classes="xp-panel"
                Margin="0,8,0,0">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="{Binding StatusMessage}" />
                <Button Classes="navigation"
                        Command="{Binding NavigateToFirstCommand}"
                        Content="FirstViewへ戻る" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
