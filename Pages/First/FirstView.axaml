<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaFunctionKeyTemplate.Pages.First"
             xmlns:data="using:AvaloniaFunctionKeyTemplate.Pages.First.Data"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="AvaloniaFunctionKeyTemplate.Pages.First.FirstView"
             x:DataType="vm:FirstViewModel"
             Loaded="OnLoaded">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:FirstViewModel />
    </Design.DataContext>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Border Classes="xp-header">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="xp-title" Text="FirstView - SQLite ToDo" />
                <Button Grid.Column="1"
                        Classes="navigation"
                        Command="{Binding NavigateToSecondCommand}"
                        Content="SecondViewへ" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="xp-panel">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBox Text="{Binding NewItemTitle}"
                         PlaceholderText="項目を入力" />
                <Button Grid.Column="1"
                        Command="{Binding AddItemCommand}"
                        Content="追加" />
                <Button Grid.Column="2"
                        Command="{Binding LoadItemsCommand}"
                        Content="再読み込み" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="xp-panel" Padding="4">
            <ListBox ItemsSource="{Binding Items}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="data:TodoItemDto">
                        <Grid ColumnDefinitions="60,*" Margin="4">
                            <TextBlock Text="{Binding Id}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="3" Classes="xp-statusbar">
            <TextBlock Text="{Binding StatusMessage}" />
        </Border>
    </Grid>

</UserControl>
